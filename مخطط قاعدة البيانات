create index IF not exists stores_registered_by_agent_id_idx on public.stores using btree (registered_by_agent_id) TABLESPACE pg_default;

create index IF not exists stores_is_active_idx on public.stores using btree (is_active) TABLESPACE pg_default;

create trigger stores_update_timestamp BEFORE
