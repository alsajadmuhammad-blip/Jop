-- =========================================
-- TABLE: users
-- =========================================

id uuid
name character varying(255)
email character varying(255)
role character varying(50)
store_id uuid
"storeId" uuid
first_login boolean
"firstLogin" boolean
payment_system character varying(50)
total_earnings numeric(12, 2)
monthly_salary numeric(12, 2)
required_stores_count integer
monthly_activations integer
last_reset_date timestamp with time zone
created_at timestamp with time zone
"createdAt" timestamp with time zone
updated_at timestamp with time zone
"updatedAt" timestamp with time zone

-- PRIMARY KEY
id

-- UNIQUE
email

-- FOREIGN KEYS
id -> auth.users(id)
store_id -> stores(id)
"storeId" -> stores(id)



-- =========================================
-- TABLE: stores
-- =========================================

id uuid
name text
description text
logo_url text
"logoUrl" text
cover_image_url text
"coverImageUrl" text
rating numeric(3, 2)
reviews integer
location text
latitude numeric
longitude numeric
type character varying(50)
market_type character varying(100)
"marketType" character varying(100)
business_hours jsonb
"businessHours" jsonb
whatsapp_number character varying(50)
"whatsappNumber" character varying(50)
has_delivery boolean
"hasDelivery" boolean
is_active boolean
"isActive" boolean
product_limit integer
"productLimit" integer
subscription_duration integer
"subscriptionDuration" integer
activation_date timestamp with time zone
"activationDate" timestamp with time zone
owner_id uuid
"ownerId" uuid
owner_email character varying(255)
"ownerEmail" character varying(255)
password text
payment_proof_url text
"paymentProofUrl" text
package_name character varying(50)
"packageName" character varying(50)
registered_by_agent_id uuid
"registeredByAgentId" uuid
created_at timestamp with time zone
"createdAt" timestamp with time zone
updated_at timestamp with time zone
"updatedAt" timestamp with time zone

-- PRIMARY KEY
id

-- FOREIGN KEYS
owner_id -> auth.users(id)
"ownerId" -> auth.users(id)
registered_by_agent_id -> auth.users(id)
"registeredByAgentId" -> auth.users(id)



-- =========================================
-- TABLE: products
-- =========================================

id uuid
store_id uuid
"storeId" uuid
category_id character varying(100)
"categoryId" character varying(100)
name character varying(255)
description text
price numeric(12, 2)
image_url text
"imageUrl" text
is_featured boolean
"isFeatured" boolean
created_at timestamp with time zone
"createdAt" timestamp with time zone
updated_at timestamp with time zone
"updatedAt" timestamp with time zone

-- PRIMARY KEY
id

-- FOREIGN KEYS
store_id -> stores(id)
"storeId" -> stores(id)



-- =========================================
-- TABLE: orders
-- =========================================

id uuid
store_id uuid
"storeId" uuid
store_name character varying(255)
"storeName" character varying(255)
customer_id uuid
"customerId" uuid
customer_name character varying(255)
"customerName" character varying(255)
customer_phone character varying(20)
"customerPhone" character varying(20)
items jsonb
total_amount numeric(12, 2)
"totalAmount" numeric(12, 2)
status character varying(50)
notes text
payment_method character varying(50)
"paymentMethod" character varying(50)
created_at timestamp with time zone
"createdAt" timestamp with time zone
updated_at timestamp with time zone
"updatedAt" timestamp with time zone

-- PRIMARY KEY
id

-- FOREIGN KEYS
store_id -> stores(id)
"storeId" -> stores(id)
customer_id -> auth.users(id)
"customerId" -> auth.users(id)



-- =========================================
-- TABLE: hero_carousel_items
-- =========================================

id uuid
src text
hint text
text text
store_id uuid
"storeId" uuid
created_at timestamp with time zone
"createdAt" timestamp with time zone
updated_at timestamp with time zone
"updatedAt" timestamp with time zone

-- PRIMARY KEY
id

-- FOREIGN KEYS
store_id -> stores(id)
"storeId" -> stores(id)



-- =========================================
-- TABLE: categories
-- =========================================

id character varying(100)
name character varying(255)
created_at timestamp without time zone

-- PRIMARY KEY
id