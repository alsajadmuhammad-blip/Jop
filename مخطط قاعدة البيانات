create unique INDEX IF not exists store_sections_store_id_name_uq on public.store_sections using btree (store_id, name) TABLESPACE pg_default;

create index IF not exists store_sections_store_id_idx on public.store_sections using btree (store_id) TABLESPACE pg_default;




